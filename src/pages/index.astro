---
import ArticleList from "../components/ArticleList.astro";
import TagFilter from "../components/TagFilter.astro";
import Layout from "../layouts/Layout.astro";
import { getBlogs, getTags } from "../library/microcms";

const response = await getBlogs();
const posts = response.contents;

// タグボタン作成 重複の排除
const tagsMap = new Map<string, { id: string; name: string }>();
posts.forEach((article) => {
	article.tags?.forEach((tag) => {
		tagsMap.set(tag.id, tag);
	});
});

const tagsResponse = await getTags();
const allTags = tagsResponse.contents;
---

<Layout title="Jamstack Portalsite">
    <main>
        <header class="mb-4 pb-4">
            <h1 class="text-2xl smm:text-3xl font-extrabold text-modern-charcoal">
                すべての記事
            </h1>
        </header>
        <section class="mb-8">
            <TagFilter tags={allTags} />
        </section>
        <ArticleList articles={posts} />
    </main>
</Layout>