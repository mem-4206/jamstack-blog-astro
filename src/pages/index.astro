---
// import ButtonLink from '../components/ButtonLink.astro';
import ArticleCard from '../components/ArticleCard.astro';
import TagButton from '../components/TagButton.astro';
import Layout from '../layouts/Layout.astro';
// import TwoCol from '../layouts/TwoColLayout.astro';

//microCMS呼び出し
import { getBlogs } from '../library/microcms';
const response = await getBlogs({ fields: ['id', 'title', 'content', 'mainVisual', 'tags'] });
const data = response.contents;
// console.log(data);

// タグ一覧を作成
let rawTags: string[] = [];
data.forEach((article) => {
    if (article.tags) {
        const splitTags = article.tags.split(',').map((tag) => tag.trim());
        rawTags.push(...splitTags);
    }
});
const uniqueTagsSet = new Set(rawTags);
const uniqueTags = [...uniqueTagsSet];
console.log("取得されたタグ▼")
console.log(uniqueTags);
---

<Layout title="Jamstack Portalsite">
    <main>
        <TagButton link='/' text='すべて' ?></TagButton>
        {
            uniqueTags.map((tagitem) => (
                <TagButton
                    link={`/?tag=${tagitem}`}
                    text={tagitem}
                />

            ))
        }
        <!-- <TagButton link={} -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {
                response.contents.map((content) => (
                    <ArticleCard
                        text={content.title}
                        link={`/${content.id}`}
                        imgUrl={content.mainVisual?.url}
                        tags={content.tags}
                    />
                ))
            }
        </div>
    </main>
</Layout>

<style>
    main {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    /* .info {
        display: flex;
        flex-direction: column;
        height: 100%;
    } */

    .iflame {
        height: 30rem;
    }
</style>

<script>
    // URLパラメータの読み込み
    const params = new URLSearchParams(window.location.search);
    const selectedTag = params.get('tag');
    console.log('選択されたタグ: ' + selectedTag);

    // 全カード取得
    const allArticles = document.querySelectorAll('article');
    console.log(allArticles);

    if (selectedTag) {
        allArticles.forEach((article) => {
            var cardTags = article.getAttribute('data-tags');
            article.classList.toggle('hidden', !cardTags?.includes(selectedTag));
            console.log(cardTags);
        });
    }
</script>
