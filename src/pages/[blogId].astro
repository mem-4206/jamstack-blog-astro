---
import ArticleCard from '../components/ArticleCard.astro';
import MetaItem from '../components/MetaItem.astro';
import Layout from '../layouts/Layout.astro';
import { formatDate } from '../library/date';
import { getBlogDetail, getBlogs } from '../library/microcms';

// 詳細記事ページの全パスを取得
export async function getStaticPaths() {
    const response = await getBlogs({ fields: ['id'] });
    return response.contents.map((content: { id: string }) => ({
        params: {
            blogId: content.id
        }
    }));
}

// 記事の詳細情報を取得
const { blogId } = Astro.params;
const blog = await getBlogDetail(blogId!);
// const blog = await getBlogDetail(blogId as string);
// console.log(blog);

const tagsArray = blog.tags ? blog.tags.map((tag) => tag.name) : [];

// 全記事情報を取得
const allPosts = await getBlogs();
const currentCategoryId = blog.category.id;
const currentPostId = blog.id;

// カテゴリが同じ記事（現在の記事以外）を取得
const relatedPosts = allPosts.contents.filter((post) => {
    return post.category?.id === currentCategoryId && post.id !== currentPostId;
});

// Dateデータの整形
const publishedAtFormatted = formatDate(blog.publishedAt);
const updatedAtFormatted = formatDate(blog.updatedAt);
const isUpdated = publishedAtFormatted !== updatedAtFormatted;

// const tagsString = blog.tags?.map((tag) => tag.name).join(',') ?? '';
---

<Layout title={`${blog.title}`}>
    <article class="mx-auto max-w-3xl py-4">
        <!-- 記事ヘッダー -->
        <header class="mb-4 pb-4">
            <!-- カテゴリ -->
            <div class="mb-2">
                {
                    blog.category && (
                        <a
                            href={`/category/${blog.category.id}`}
                            class="bg-white text-modern-charcoal px-3 py-1 rounded-full text-xs font-semibold border-2 border-modern-charcoal hover:bg-modern-blue hover:text-white transition-colors"
                        >
                            {blog.category.name}
                        </a>
                    )
                }
            </div>
            <h1
                class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight mb-2"
            >
                {blog.title}
            </h1>
            <div class="flex flex-wrap items-center gap-2 mb-2">
                {
                    blog.tags?.map((tag) => (
                        <a
                            href={`/?tag=${tag.id}`}
                            class="text-modern-charcoal text-xs font-medium hover:text-modern-red transition-colors"
                        >
                            #{tag.name}
                        </a>
                    ))
                }
            </div>
            <div class="flex items-center gap-4 text-xs sm:text-sm text-slate-500">
                <MetaItem iconName="mdi:calendar">
                    <time datetime={blog.publishedAt}>{publishedAtFormatted}</time>
                </MetaItem>
                {
                    isUpdated && (
                        <MetaItem iconName="material-symbols:update">
                            <time datetime={blog.updatedAt}>{updatedAtFormatted}</time>
                        </MetaItem>
                    )
                }
            </div>
        </header>

        {
            blog.mainVisual && (
                <div class="mb-8 rounded-xl overflow-hidden aspect-ratio bg-slate-100 shadow-sm">
                    <img src={blog.mainVisual.url} alt="" class="w-full h-full object-cover" />
                </div>
            )
        }

        <div class="prose prose-slate prose-indigo sm:prose-lg max-w-none mb-12">
            <div set:html={blog.content} />
        </div>

        <footer class="pt-8 border-t border-slate-200">
            <a
                href="/"
                class="inline-flex items-center gap-2 text-sm font-medium text-slate-600 hover:text-indigo-600 transition-colors"
            >
                ← 記事一覧に戻る
            </a>
            <h2 class="text-2xl mb-4">
                <MetaItem iconName="material-symbols:folder">{blog.category?.name}</MetaItem>
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {relatedPosts.map((content) => <ArticleCard article={content} />)}
            </div>
        </footer>
    </article>
</Layout>
