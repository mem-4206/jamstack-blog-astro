---
import ArticleList from "../components/ArticleList.astro";
import MetaItem from "../components/MetaItem.astro";
import Layout from "../layouts/Layout.astro";
import { formatDate } from "../library/date";
import {
    type Blog,
    getBlogDetail,
    getBlogs,
    getCategories,
    getRelatedPosts,
} from "../library/microcms";

// 全記事のIDを取得してパスを生成する
export async function getStaticPaths() {
    const categories = await getCategories();
    const response = await getBlogs({ fields: ["id"] });
    return response.contents.map((content) => ({
        params: { blogId: content.id },
    }));
}

// 記事の詳細情報を取得
const { blogId } = Astro.params;

// パラメータの存在をチェック
if (!blogId) {
    return Astro.redirect("/404");
}

// 記事データの取得と 404 ハンドリング
let blog: Blog | null = null;

try {
    blog = await getBlogDetail(blogId);
} catch (e) {
    return Astro.redirect("/404");
}

if (!blog) {
    return Astro.redirect("/404");
}

// 関連記事の取得
let relatedPosts: Blog[] = [];

if (blog.category?.id) {
    const response = await getRelatedPosts(blog.category.id, blog.id);
    relatedPosts = response.contents;
}

// Dateデータの整形
const publishedAtFormatted = formatDate(blog.publishedAt);
const updatedAtFormatted = formatDate(blog.updatedAt);
const isUpdated = publishedAtFormatted !== updatedAtFormatted;
---

<Layout title={`${blog.title}`}>
    <main class="mx-auto max-w-3xl">
        <article class="mb-16">
            <!-- 記事ヘッダー -->
            <header class="mb-4 pb-4">
                <!-- カテゴリ -->
                <div class="mb-2">
                    {
                        blog.category && (
                            <a
                                href={`/category/${blog.category.id}`}
                                class="bg-white text-modern-charcoal px-3 py-1 rounded-full text-md font-semibold border-2 border-modern-charcoal hover:bg-modern-blue hover:text-white transition-colors"
                            >
                                {blog.category.name}
                            </a>
                        )
                    }
                </div>
                <h1
                    class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight mb-2"
                >
                    {blog.title}
                </h1>
                <div class="flex flex-wrap items-center gap-2 mb-2">
                    {
                        blog.tags?.map((tag) => (
                            <a
                                href={`/?tag=${tag.id}`}
                                class="text-modern-charcoal text-xs font-medium hover:text-modern-red transition-colors"
                            >
                                #{tag.name}
                            </a>
                        ))
                    }
                </div>
                <div
                    class="flex items-center gap-4 text-xs sm:text-sm text-slate-500"
                >
                    <MetaItem iconName="mdi:calendar">
                        <time datetime={blog.publishedAt}
                            >{publishedAtFormatted}</time
                        >
                    </MetaItem>
                    {
                        isUpdated && (
                            <MetaItem iconName="material-symbols:update">
                                <time datetime={blog.updatedAt}>
                                    {updatedAtFormatted}
                                </time>
                            </MetaItem>
                        )
                    }
                </div>
            </header>

            {
                blog.mainVisual && (
                    <div class="mb-8 rounded-xl overflow-hidden aspect-ratio bg-slate-100 shadow-sm">
                        <img
                            src={blog.mainVisual.url}
                            alt=""
                            class="w-full h-full object-cover"
                        />
                    </div>
                )
            }

            <div class="prose prose-slate prose-indigo sm:prose-lg max-w-none">
                <div set:html={blog.content} />
            </div>
        </article>

        <section class="mt-12 pt-8 border-t border-slate-900 mb-16">
            <h2 class="text-2xl mb-4 font-semibold">
                <a
                    href={`/category/${blog.category.id}`}
                    class="text-modern-blue">"{blog.category?.name}"</a
                > のほかの記事
            </h2>
            <ArticleList articles={relatedPosts} />
        </section>
    </main>
</Layout>
