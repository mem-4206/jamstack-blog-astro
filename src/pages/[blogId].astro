---
import ArticleCard from '../components/ArticleCard.astro';
import MetaItem from '../components/MetaItem.astro';
import Layout from '../layouts/Layout.astro';
import { formatDate } from '../library/date';
import { getBlogDetail, getBlogs } from '../library/microcms';

// 詳細記事ページの全パスを取得
export async function getStaticPaths() {
    const response = await getBlogs({ fields: ['id'] });
    return response.contents.map((content: { id: string }) => ({
        params: {
            blogId: content.id
        }
    }));
}

// 記事の詳細情報を取得
const { blogId } = Astro.params;
const blog = await getBlogDetail(blogId as string);
// console.log(blog);

const tagsArray = blog.tags ? blog.tags.map((tag) => tag.name) : [];

// if (blog.tags) {
//     const splitTags = blog.tags.split(',').map((tag) => tag.trim());
//     tagsArray.push(...splitTags);
// }

// 全記事情報を取得
const allPosts = await getBlogs();
const currentCategoryId = blog.category.id;
const currentPostId = blog.id;

// カテゴリが同じ記事（現在の記事以外）を取得
const relatedPosts = allPosts.contents.filter((post) => {
    return post.category?.id === currentCategoryId && post.id !== currentPostId;
});
console.log('====================================');
console.log('▼ relatedPosts');
console.log(relatedPosts);
console.log('====================================');

// Dateデータの整形
const publishedAt = new Date(blog.publishedAt);
const updatedAt = new Date(blog.updatedAt);
const publishedAtDate = publishedAt.toLocaleDateString('ja-JP', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit'
});
const updatedAtDate = updatedAt.toLocaleDateString('ja-JP', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit'
});

const tagsString = blog.tags?.map((tag) => tag.name).join(',') ?? '';
---

<Layout title="My first blog with Astro">
    <main class="mx-auto max-w-4xl px-4 py-8">
        <h1 class="text-3xl my-8">{blog.title}</h1>
        <img src={blog.mainVisual.url} alt="" />
        <div class="bg-gray-50 rounded-xl p-5 text-gray-700 text-sm my-8 flex flex-col gap-2">
            <MetaItem iconName="material-symbols:folder">{blog.category?.name}</MetaItem>
            <MetaItem iconName="mdi:tag">
                {tagsArray.map((tagitem) => <a href={`/?tag=${tagitem}`}>{tagitem}</a>)}
            </MetaItem>
            <div class="flex items-center gap-2 text-sm text-gray-600">
                <MetaItem iconName="mdi:calendar">{publishedAtDate}</MetaItem>
                <div class="flex items-center">
                    （<MetaItem iconName="material-symbols:update">{updatedAtDate}</MetaItem>）
                </div>
            </div>
        </div>
        <div class="my-16" set:html={blog.content} />
    </main>
    <footer class="bg-gray-50 py-16 px-4">
        <aside class="mx-auto max-w-4xl">
            <h2 class="text-2xl mb-4"><MetaItem iconName="material-symbols:folder">{blog.category?.name}</MetaItem></h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {relatedPosts.map((content) => <ArticleCard article={content} />)}
            </div>
        </aside>
    </footer>
</Layout>