---
import Layout from "../layouts/Layout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import MetaItem from "../components/MetaItem.astro";
import { getBlogs, getBlogDetail, getRelatedPosts } from "../library/microcms";

// 詳細記事ページの全パスを取得
export async function getStaticPaths() {
	const response = await getBlogs({ fields: ["id"] });
	return response.contents.map((content: { id: string }) => ({
		params: {
			blogId: content.id,
		},
	}));
}

// 記事の詳細情報を取得
const { blogId } = Astro.params;
const blog = await getBlogDetail(blogId as string);
console.log(blog);

// 全記事情報を取得
const allPosts = await getBlogs({
	fields: ["id", "title", "category", "mainVisual"],
});
const currentCategoryId = blog.category.id;
const currentPostId = blog.id;

// カテゴリが同じ記事（現在の記事以外）を取得
const relatedPosts = allPosts.contents.filter((post) => {
	return post.category?.id === currentCategoryId && post.id !== currentPostId;
});
console.log("====================================");
console.log("▼ relatedPosts");
console.log(relatedPosts);
console.log("====================================");

// Dateデータの整形
const publishedAt = new Date(blog.publishedAt);
const updatedAt = new Date(blog.updatedAt);
const publishedAtDate = publishedAt.toLocaleDateString("ja-JP", {
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
});
const updatedAtDate = updatedAt.toLocaleDateString("ja-JP", {
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
});
---

<Layout title="My first blog with Astro">
    <main>
        <h1 class="text-3xl my-8">{blog.title}</h1>
        <img src={blog.mainVisual.url} alt="" />
        <div class="bg-gray-50 rounded-xl p-5 text-gray-700 text-sm my-8 flex flex-col gap-2">
            <MetaItem iconName="material-symbols:folder" text={blog.category?.name} />
            {blog.tags && <MetaItem iconName="mdi:tag" text={blog.tags} />}
            <div class="flex items-center gap-2 text-sm text-gray-600">
                <MetaItem iconName="mdi:calendar" text={publishedAtDate} />
                <div class="flex items-center">
                    （<MetaItem iconName="material-symbols:update" text={updatedAtDate} />）
                </div>
            </div>
        </div>
        <div class="post" set:html={blog.content} />
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {
                relatedPosts.map((content) => (
                    <ArticleCard text={content.title} link={content.id} imgUrl={content.mainVisual?.url} />
                ))
            }
        </div>
    </main>
</Layout>

<style>
    main {
        margin: auto;
        padding: 1em;
        max-width: 60ch;
    }
</style>
