---
import Layout from '../layouts/Layout.astro';
import MetaItem from '../components/MetaItem.astro';
import { getBlogs, getBlogDetail } from '../library/microcms';

// 詳細記事ページの全パスを取得
export async function getStaticPaths() {
    const response = await getBlogs({ fields: ['id'] });
    return response.contents.map((content: { id: string }) => ({
        params: {
            blogId: content.id
        }
    }));
}

// 記事の詳細情報を取得
const { blogId } = Astro.params;
const blog = await getBlogDetail(blogId as string);
---

<Layout title="My first blog with Astro">
    <main>
        <h1 class="title">{blog.title}</h1>
        <img src={blog.mainVisual.url} alt="" />
        <MetaItem iconName="material-symbols:folder" text={blog.category}></MetaItem>
        <MetaItem iconName="mdi:tag" text={blog.tags}></MetaItem>
        <div class="publishedAt">公開日時：{blog.publishedAt}</p>
        <div class="post" set:html={blog.content} />
    </main>
</Layout>

<style>
    main {
        margin: auto;
        padding: 1em;
        max-width: 60ch;
    }
</style>
