---
import Layout from '../layouts/Layout.astro';
import MetaItem from '../components/MetaItem.astro';
import { getBlogs, getBlogDetail } from '../library/microcms';

// 詳細記事ページの全パスを取得
export async function getStaticPaths() {
    const response = await getBlogs({ fields: ['id'] });
    return response.contents.map((content: { id: string }) => ({
        params: {
            blogId: content.id
        }
    }));
}

// 記事の詳細情報を取得
const { blogId } = Astro.params;
const blog = await getBlogDetail(blogId as string);
console.log(blog);

// Dateデータの整形
const publishedAt = new Date(blog.publishedAt);
const updatedAt = new Date(blog.updatedAt);
const publishedAtDate = publishedAt.toLocaleDateString('ja-JP',{
    year: 'numeric',
    month: '2-digit',
    day: '2-digit'
});
const updatedAtDate = updatedAt.toLocaleDateString('ja-JP',{
    year: 'numeric',
    month: '2-digit',
    day: '2-digit'
})
---

<Layout title="My first blog with Astro">
    <main>
        <h1 class="title">{blog.title}</h1>
        <img src={blog.mainVisual.url} alt="" />
        <MetaItem iconName="material-symbols:folder" text={blog.category}></MetaItem>
        {
            blog.tags && (
                <MetaItem iconName="mdi:tag" text={blog.tags}></MetaItem>
            )
        }
        <div class="flex items-center gap-4 text-sm text-gray-600">
            <MetaItem iconName="mdi:calendar" text={publishedAtDate}></MetaItem>
            <div class="flex items-center gap-1">
                （<MetaItem iconName="material-symbols:update" text={updatedAtDate}></MetaItem>）
            </div>
        </div>
        <div class="post" set:html={blog.content} />
    </main>
</Layout>

<style>
    main {
        margin: auto;
        padding: 1em;
        max-width: 60ch;
    }
</style>
