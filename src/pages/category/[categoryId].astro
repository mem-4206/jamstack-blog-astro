---
import Layout from '../../layouts/Layout.astro';
import { getBlogs, getCategories } from '../../library/microcms'

export async function getStaticPaths() {
    const response = await getCategories({ fields: ['id'] });
    return response.contents.map((content: { id: string }) => ({
        params: {
            categoryId: content.id
        }
    }))
}

const { categoryId } = Astro.params;
const response = await getBlogs({
    filters: `category[equals]${categoryId}`,
});

const posts = response.contents;
---

<Layout title="カテゴリ別記事一覧">
    <main>
        <h1>カテゴリ別記事一覧</h1>
        <ul>
            {posts.map((post) => (
                <li>
                    { /* ここで記事のタイトルやリンクを表示 */ }
                    <a href={`/${post.id}`}>{post.title}</a>
                </li>
            ))}
        </ul>
    </main>
</Layout>