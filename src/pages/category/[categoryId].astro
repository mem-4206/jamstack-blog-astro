---
import ArticleList from '../../components/ArticleList.astro';
import TagFilter from '../../components/TagFilter.astro';
import Layout from '../../layouts/Layout.astro';
import { getBlogs, getCategories } from '../../library/microcms';
import { extractUniqueTags } from '../../library/utils';

export async function getStaticPaths() {
    const response = await getCategories();
    return response.contents.map((content) => ({
        params: { categoryId: content.id }
    }));
}

const { categoryId } = Astro.params;

if (!categoryId) {
    return Astro.redirect('/404');
}

const categoriesResponse = await getCategories();
const category = categoriesResponse.contents.find((c) => c.id === categoryId);

if (!category) {
    return Astro.redirect('/404');
}

// 該当カテゴリの記事一覧を取得
const blogsResponse = await getBlogs({
    filters: `category[equals]${categoryId}`,
});
const articles = blogsResponse.contents;

const categoryTags = extractUniqueTags(articles);
---

<Layout title={`${category.name}の記事一覧 | My Blog.`}>
    <div class="max-w-5xl mx-auto">
        <header class="mb-4 pb-4">
            <h1 class="text-2xl smm:text-3xl font-extrabold text-modern-charcoal">
                {category.name}
            </h1>
        </header>
        {categoryTags.length > 0 && <TagFilter tags={categoryTags} />}
        <ArticleList articles={articles} />
    </div>
</Layout>
