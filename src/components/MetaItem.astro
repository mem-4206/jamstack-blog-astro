---
import { Icon } from 'astro-icon/components';

interface Props {
    iconName?: string;
    class?: string;
}

const { iconName, class: className = '' } = Astro.props;
---

<div class={`inline-flex items-center gap-1.5 text-xs sm:text-sm text-slate-500 ${className}`}>
    {
        iconName && (
            <span class="inline-flex shrink-0">
                <Icon name={iconName} class="w-4 h-4" />
            </span>
            <div class="flex flex-wrap items-center gap-1.5">
                <slot />
            </div>
        )
    }
</div>
