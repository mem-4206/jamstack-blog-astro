---
import MetaItem from '../components/MetaItem.astro';
import { formatDate } from '../library/date';
import type { Blog } from '../library/microcms';

interface Props {
    article: Blog;
}

const { article } = Astro.props;

// タグ配列をカンマ区切りの文字列に変換
const tags = article.tags || [];
const tagsString = tags?.map((tag) => tag.id).join(',') || '';

// 公開日・更新日を取得する
const publishedAtFormatted = formatDate(article.publishedAt);
const updatedAtFormatted = formatDate(article.updatedAt);
const isUpdated = publishedAtFormatted !== updatedAtFormatted;
---

<article data-tags={tagsString} class="overflow-hidden flex flex-col md:flex-row h-full">
    <a href={`/${article.id}`} class="block flex-1 flex flex-col">
        {
            article.mainVisual && (
                <div class="aspect-video w-full overflow-hidden bg-slate-100">
                    <img
                        src={article.mainVisual.url}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    />
                </div>
            )
        }
    </a>
    <div class="py-2 flex-1 flex flex-col justify-between">
        <div class="flex items-center gap-2 text-xs text-slate-400 my-2">
            <MetaItem iconName="mdi:calendar">
                <time datetime={article.publishedAt}>{publishedAtFormatted}</time>
            </MetaItem>
            {
                isUpdated && (
                    <MetaItem iconName="material-symbols:update">
                        <time datetime="{article.updatedAt">{updatedAtFormatted}</time>
                    </MetaItem>
                )
            }
        </div>

        <div>
            <a href={`/${article.id}`}>
                <h2 class="text-lg font-bold text-modern-charcol mb-2 line-clamp-2">{article.title}</h2>
            </a>

            {
                article.category && (
                    <MetaItem iconName="material-symbols:folder">
                        <a href={`/category/${article.category.id}`}>{article.category?.name}</a>
                    </MetaItem>
                )
            }

            <div class="flex flex-wrap items-center gap-y-2 gap-x-4 text-xs sm:text-sm text-slate-500 mb-3">
                {
                    tags.length > 0 && (
                        <div class="flex gap-2">
                            {tags.map((tag) => (
                                <a href={`/?tag=${tag.id}`} class="text-slate-600">
                                    #{tag.name}
                                </a>
                            ))}
                        </div>
                    )
                }
            </div>
        </div>
    </div>
</article>
