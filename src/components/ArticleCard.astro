---
import MetaItem from '../components/MetaItem.astro';
import { formatDate } from '../library/date';
import type { Blog } from '../library/microcms';

interface Props {
    article: Blog;
}

const { article } = Astro.props;

// タグ配列をカンマ区切りの文字列に変換
const tags = article.tags || [];
const tagsString = tags?.map((tag) => tag.id).join(',') || '';

// 公開日・更新日を取得する
const publishedAtFormatted = formatDate(article.publishedAt);
const updatedAtFormatted = formatDate(article.updatedAt);
const isUpdated = publishedAtFormatted !== updatedAtFormatted;

const articleUrl = `/${article.id}`;
---

<article
    data-tags={tagsString}
    class="group relative overflow-hidden flex flex-col h-full rounded-xl shadow-solid border-2 border-modern-charcoal transition-all hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-[2px_2px_0px_0px_#2B2B2A] active:translate-x-1 active:translate-y-1 active:shadow-none"
>
    <!-- カード全体のリンク -->
    <a href={articleUrl} class="absolute inset-0 z-10" aria-label={article.title}></a>

    <!-- アイキャッチ -->
    {
        article.mainVisual && (
            <div class="relative aspect-video w-full md:h-auto overflow-hidden bg-slate-100 shrink-0">
                <img
                    src={article.mainVisual.url}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
                {article.category && (
                    <span class="absolute z-20 bottom-2 left-2 font-semibold text-xs text-modern-charcoal hover:text-white bg-white hover:bg-modern-blue rounded-full border-2 border-modern-charcoal px-2 py-1 cursor-pointer">
                        <a href={`/category/${article.category.id}`}>{article.category?.name}</a>
                    </span>
                )}
            </div>
        )
    }

    <div class="px-4 py-4 flex-1 flex flex-col justify-between">
        <div>
            <h2 class="text-xl font-bold text-modern-charcoal mb-1 line-clamp-2 group-hover:underline">
                {article.title}
            </h2>

            <div class="flex flex-wrap items-center gap-y-2 gap-x-4 text-xs sm:text-sm text-slate-500 mb-3">
                {
                    tags.length > 0 && (
                        <div class="flex gap-2">
                            {tags.map((tag) => (
                                <span class="text-slate-600">#{tag.name}</span>
                            ))}
                        </div>
                    )
                }
            </div>
            <!-- 公開日と更新日 -->
            <div class="flex items-center gap-2 text-xs text-slate-400">
                <MetaItem iconName="mdi:calendar">
                    <time datetime={article.publishedAt}>{publishedAtFormatted}</time>
                </MetaItem>
                {
                    isUpdated && (
                        <MetaItem iconName="material-symbols:update">
                            <time datetime="{article.updatedAt">{updatedAtFormatted}</time>
                        </MetaItem>
                    )
                }
            </div>
        </div>
    </div>
</article>
