---
// import TagButton from '../components/TagButton.astro';
import MetaItem from '../components/MetaItem.astro';

interface Props {
    article: {
        id: string;
        mainVisual: { url: string };
        title: string;
        category: { name: string };
        tags?: { id: string; name: string }[];
        publishedAt: string;
        updatedAt: string;
    };
}

const { article } = Astro.props;
console.log('articleの中身:', article.publishedAt, article.updatedAt);

// タグ配列をカンマ区切りの文字列に変換
const tagsArray = article.tags ? article.tags.map((tag) => tag.name) : [];
const tagsString = article.tags?.map((tag) => tag.name).join(',') || '';

// 日付の整形
// 「2026/08/17」形式で返します（スラッシュをドットにしたい場合は最後に .replaceAll('/', '.') を付与）
const formatDate = (dateStr: string) => {
    if (!dateStr) return '';
    return new Date(dateStr).toLocaleDateString('ja-JP', {
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
    });
};

const publishedAtFormatted = formatDate(article.publishedAt);
const updatedAtFormatted = formatDate(article.updatedAt);
---

<article data-tags={tagsString} class="p-4 flex flex-col md:flex-row">
    <a href={`/${article.id}`}
        ><img src={article.mainVisual.url} alt="" class="aspect-video w-full object-cover md:w-2/5 shrink-0" /></a
    >
    <a href={`/${article.id}`}><h2 class="text-lg text-slate-900 line-clamp-2">{article.title}</h2></a>
    <MetaItem iconName="material-symbols:folder">{article.category?.name}</MetaItem>
    {
        tagsArray.length > 0 && (
            <MetaItem iconName="mdi:tag">
                {tagsArray.map((tagitem) => (
                    <a href={`/?tag=${tagitem}`}>{tagitem}</a>
                ))}
            </MetaItem>
        )
    }
    <div class="flex items-center gap-2 text-sm text-gray-600">
        <MetaItem iconName="mdi:calendar">{publishedAtFormatted}</MetaItem>
        <div class="flex items-center">
            （<MetaItem iconName="material-symbols:update">{updatedAtFormatted}</MetaItem>）
        </div>
    </div>
</article>
