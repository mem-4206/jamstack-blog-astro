---
import type { Blog } from '../library/microcms';

interface Props {
    article: Blog;
}

const { article } = Astro.props;

const tagsString = article.tags?.map((tag) => tag.name).join(',') ?? '';
---

<article data-tags={tagsString}>
    <a href={`/${article.id}`}>
        <img src={article.mainVisual.url} alt="" />
        <div class="my-4">{article.title}</div>
    </a>
</article>
