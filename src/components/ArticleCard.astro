---
import TagButton from '../components/TagButton.astro';

interface Props {
    article: {
        id: string;
        mainVisual: {
            url: string;
        };
        title: string;
        category: {
            name: string;
        };
        tags?: string;
    };
}

const { article } = Astro.props;

let tagsArray: string[] = [];

if (article.tags) {
    const splitTags = article.tags.split(',').map((tag) => tag.trim());
    tagsArray.push(...splitTags);
}
---

<article data-tags={article.tags}>
    <a href={`/${article.id}`}>
        <img src={article.mainVisual.url} alt="" />
        <div class="my-4">{article.title}</div>
        <div>{article.category.name}</div>
        <div class="flex gap-4">
            {tagsArray.map((tagitem) => <TagButton link={`/?tag=${tagitem}`} text={tagitem} />)}
        </div>
    </a>
</article>
