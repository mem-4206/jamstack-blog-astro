---
import { getBlogs, getCategories } from '../library/microcms';

// 1. カテゴリ一覧と記事一覧を並行して取得
const [categoriesResponse, blogsResponse] = await Promise.all([
    getCategories(),
    getBlogs({ limit: 100 }) // 件数上限を指定（必要に応じて調整）
]);

const categories = categoriesResponse.contents;
const blogs = blogsResponse.contents;

// 2. カテゴリごとの記事数をカウント
const categoryCountMap = new Map<string, number>();

blogs.forEach((blog) => {
    if (blog.category?.id) {
        const currentCount = categoryCountMap.get(blog.category.id) || 0;
        categoryCountMap.set(blog.category.id, currentCount + 1);
    }
});

// 3. 記事数が多い順（降順）にカテゴリをソート
const sortedCategories = [...categories].sort((a, b) => {
    const countA = categoryCountMap.get(a.id) || 0;
    const countB = categoryCountMap.get(b.id) || 0;
    return countB - countA; // 降順（多い順）
});
---

<header>
    <div class="max-w-5xl px-4 sm:px-6 py-4 flex justify-between items-center">
        <a href="/" class="text-xl font-bold text-slate-900"> My Blog </a>
        {
            (
                <details class="relative group">
                    <summary class="flex items-center gap-1 text-sm font-bold text-modern-charcoal cursor-pointer list-none select-none py-2 px-3">
                        <span>カテゴリー</span>
                        <svg
                            class="w-4 h-4 text-modern-charcoal group-open:rotate-180"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    </summary>

                    <div class="absolute right-0 mt-2 w-48 bg-modern-paper rounded-xl py-2 z-50 shadow-solid border-2 border-modern-charcoal">
                        {sortedCategories.map((cat) => {
                            const count = categoryCountMap.get(cat.id) || 0;
                            return (
                                <a
                                    href={`/category/${cat.id}`}
                                    class="flex items-center justify-between px-4 py-2.5 text-sm font-bold text-modern-charcoal hover:bg-indigo-50 transition-colors"
                                >
                                    <span>{cat.name}</span>
                                    <span class="text-xs text-white bg-modern-red px-2 py-0.5 rounded-full">
                                        {count}
                                    </span>
                                </a>
                            );
                        })}
                    </div>
                </details>
            )
        }
    </div>
</header>

<script>
    document.addEventListener('click', (e) => {
        const details = document.querySelectorAll('details');
        details.forEach((detail) => {
            if (!detail.contains(e.target as Node)) {
                detail.removeAttribute('open');
            }
        });
    });
</script>
